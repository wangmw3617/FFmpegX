# 统一换行符：仓库内文本一律 LF，避免 Windows / Linux 混用导致「整文件 diff」。
# 本地工作区检出时也按 LF，保证与 CI（Linux）一致。
* text=auto eol=lf

# ---- 二进制（禁止做换行/编码转换）----
*.jar   binary
*.aar   binary
*.apk   binary
*.aab   binary
*.so    binary
*.dylib binary
*.dll   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.zip   binary

# ---- 平台相关脚本 ----
# Windows 批处理必须是 CRLF，否则 cmd 解析可能出错
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Shell / Python / Gradle wrapper 必须是 LF，否则 Linux / CI 上 shebang 失效
*.sh    text eol=lf
*.py    text eol=lf
gradlew text eol=lf

# ---- 可执行位 ----
# 在 Windows 上提交时空文件权限不会被记录，gradlew 会以 100644 入库，
# 到 Linux runner 上执行 ./gradlew 直接 "Permission denied"（exit 126）。
# 这里声明为 executable，让 Git 把权限位写进 index（100755），跨平台一致。
gradlew            text eol=lf executable
scripts/*.sh       text eol=lf executable

# ---- 生成物（标记为不参与 diff/统计，减少噪音）----
gradle/wrapper/gradle-wrapper.jar binary
